# Copy to `.env` and fill in your key(s). `.env` is gitignored.
# The two LangGraph audit agents read the key named by config.yaml `agents.api_key_env`.

# Google Gemini (default provider). Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional fallbacks if you switch agents.provider in config.yaml:
# GOOGLE_API_KEY=        # alternate env name the Gemini provider also checks
# ANTHROPIC_API_KEY=     # provider: anthropic
# OPENAI_API_KEY=        # provider: openai
